[Unit]
Description=ODD Invest portfolio manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oddinvestd
Group=oddinvestd
ExecStart=/usr/local/bin/oddinvestd
Restart=on-failure
RestartSec=5

Environment=ODDINVEST_HTTP_ADDR=:8080
Environment=ODDINVEST_DB_PATH=/var/lib/oddinvestd/oddinvest.db
# Environment=ODDINVEST_MQTT_ADDR=tcp://homeassistant.local:1883
# Environment=ODDINVEST_MQTT_USER=oddinvest
# Environment=ODDINVEST_MQTT_PASS=***
Environment=ODDINVEST_MQTT_PREFIX=oddinvest
# Секретів тут немає: пароль, токен для HA й реквізити тунелю живуть у
# базі й задаються з самого застосунку (README → «Доступ ззовні»).

StateDirectory=oddinvestd
# Право слухати 443 без root: сервіс віддає там ту саму адресу, що й
# тунель, лише напряму в локальній мережі (internal/tunnel/cert.go).
# NoNewPrivileges цьому не заважає — ambient-права видає systemd при exec,
# а NNP забороняє інше: setuid і права з файлів.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oddinvestd
PrivateTmp=true

[Install]
WantedBy=multi-user.target
