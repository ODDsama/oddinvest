[Unit]
Description=ODD Invest backend (oddinvestd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oddinvestd
Group=oddinvestd
ExecStart=/usr/local/bin/oddinvestd
Restart=on-failure
RestartSec=5

# Єдина копія юніта: deploy/lxc-deploy.sh ставить САМЕ цей файл на
# кожному деплої, а proxmox-lxc.sh — на провізії. Доти юніт жив у трьох
# місцях (цей «довідковий», heredoc у провізії й sed-латки в деплої для
# старих контейнерів), і копії вже розійшлись: у heredoc не було UMask.
#
# Змінні — у /etc/oddinvestd.env (адреса, база, MQTT; пише провізія).
# Секретів застосунку там немає: пароль, токен для HA й реквізити тунелю
# живуть у базі й задаються з самого застосунку (README → «Доступ ззовні»).
EnvironmentFile=/etc/oddinvestd.env

StateDirectory=oddinvestd
# Файли сервісу — лише для нього. У базі відкритим текстом лежать токени
# Cloudflare й тунелю та ключ сертифіката, і ті самі секрети їдуть у
# кожну копію .pre-* і добовий дамп. Сховище саме ставить 0600, але лише
# після вдалих міграцій; umask закриває файли з першої ж секунди.
UMask=0077
StateDirectoryMode=0700
# Право слухати 443 без root: сервіс віддає там ту саму адресу, що й
# тунель, лише напряму в локальній мережі (internal/tunnel/cert.go).
# NoNewPrivileges цьому не заважає — ambient-права видає systemd при exec,
# а NNP забороняє інше: setuid і права з файлів.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oddinvestd
PrivateTmp=true

[Install]
WantedBy=multi-user.target
